{
  "name": "@probara/browser",
  "version": "0.0.0",
  "description": "Probara error monitoring for the browser: uncaught errors, unhandled rejections and captured errors with breadcrumbs and context, and a replay of what led to an error, sharing one capture engine with Probara Vis.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynch-me/probara-sdk.git",
    "directory": "packages/browser"
  },
  "keywords": [
    "probara",
    "error-monitoring",
    "errors",
    "crash-reporting",
    "browser",
    "sdk"
  ],
  "scripts": {
    "sync-version": "node --experimental-strip-types scripts/sync-version.mts",
    "prebuild": "pnpm run sync-version",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@probara/vis-capture": "workspace:*"
  },
  "devDependencies": {
    "@probara/error-core": "workspace:*",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
