{
  // Tests, scripts and configs: the browser sources plus the Node types the Node-side tests and
  // scripts use. `tsconfig.check.json` checks the shipped sources alone, without Node types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ES2024.String", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@probara/error-core": ["../error-core/src/index.ts"],
      "@probara/vis-capture": ["../vis-capture/src/index.ts"],
      "@probara/vis-capture/replay": ["../vis-capture/src/replay.ts"]
    }
  },
  "include": ["src", "scripts", "vitest.config.ts", "tsdown.config.ts"]
}
