{
  "name": "@probara/core",
  "version": "0.1.0",
  "description": "Core library for reporting automated test results to Probara.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynch-me/probara-sdk.git",
    "directory": "packages/core"
  },
  "keywords": [
    "probara",
    "test-management",
    "reporter",
    "ci"
  ],
  "scripts": {
    "sync-version": "node --experimental-strip-types scripts/sync-version.ts",
    "prebuild": "pnpm run sync-version",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:api": "node --experimental-strip-types scripts/generate-api.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
