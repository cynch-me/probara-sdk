{
  "name": "@probara/jest-reporter",
  "version": "0.1.0",
  "description": "Jest reporter that sends every test result to Probara.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynch-me/probara-sdk.git",
    "directory": "packages/jest-reporter"
  },
  "keywords": [
    "probara",
    "test-management",
    "jest",
    "reporter",
    "ci"
  ],
  "scripts": {
    "sync-version": "node --experimental-strip-types scripts/sync-version.mts",
    "prebuild": "pnpm run sync-version",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@probara/core": "workspace:*"
  },
  "peerDependencies": {
    "jest": ">=29.6.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@jest/reporters": "^30.5.2",
    "@probara/cli": "workspace:*",
    "@probara/test-support": "workspace:*",
    "jest": "^30.5.2",
    "jest-29": "npm:jest@29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-jsdom-29": "npm:jest-environment-jsdom@29.7.0",
    "jest-junit": "^17.0.0",
    "typescript": "~5.9.3"
  }
}
