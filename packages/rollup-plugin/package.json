{
  "name": "@probara/rollup-plugin",
  "version": "0.0.0",
  "description": "Probara Rollup plugin: gives the emitted JavaScript files a debug ID and the release, and uploads their source maps to Probara error monitoring after the build.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynch-me/probara-sdk.git",
    "directory": "packages/rollup-plugin"
  },
  "keywords": [
    "probara",
    "error-monitoring",
    "source-maps",
    "debug-id",
    "rollup",
    "rollup-plugin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@probara/core": "workspace:*",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@probara/bundler-plugin-core": "workspace:*",
    "rollup": "^4.64.5",
    "tsdown": "^0.23.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
