{
  "name": "@probara/test-support",
  "version": "0.0.0",
  "private": true,
  "description": "Test helpers the Probara adapters share, such as the fake Probara API and the docs harness. Never published.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./build": "./src/build.ts",
    "./fake-probara": "./src/fake-probara.ts",
    "./docs/examples": "./src/docs/examples.ts",
    "./docs/jobs": "./src/docs/jobs.ts",
    "./docs/links": "./src/docs/links.ts",
    "./docs/markdown": "./src/docs/markdown.ts",
    "./docs/options": "./src/docs/options.ts",
    "./docs/redirect": "./src/docs/redirect.ts",
    "./docs/shell": "./src/docs/shell.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@probara/core": "workspace:*",
    "typescript": "~5.9.3"
  }
}
